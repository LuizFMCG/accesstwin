# Chave restrita por HTTP referrer: Maps JavaScript API + Places API.
GOOGLE_MAPS_BROWSER_API_KEY=

# Chave somente de servidor: Isochrones API + Places Aggregate API.
GOOGLE_MAPS_SERVER_API_KEY=

GOOGLE_CLOUD_PROJECT_ID=accesstwin-lfg-2026

# Kill switch e tetos do produto. Mantenha os limites também no Google Cloud.
ACCESSTWIN_LIVE_ENABLED=true
ACCESSTWIN_RATE_LIMIT=12
ACCESSTWIN_DAILY_ANALYSIS_LIMIT=100
ACCESSTWIN_CACHE_TTL_HOURS=24
